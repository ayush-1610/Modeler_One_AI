# Copy to ~/.modeler-secrets.env on the server, fill in, then: chmod 600 ~/.modeler-secrets.env
# Never commit the filled-in file. Rotate any key that was ever pasted into a document or chat.
# Shell syntax: no spaces around "=". The server scripts read this file, not ~/.bashrc.
export MODELER_LLM_PROVIDER=litellm              # litellm | disabled
export LITELLM_BASE=http://127.0.0.1:4000/v1      # the LiteLLM proxy on this server
export LITELLM_KEY=                               # the proxy's master key
export MODELER_LLM_MODEL=qwen-coder               # LiteLLM's alias, not the Ollama tag qwen3-coder:30b
export MODELER_LLM_TIMEOUT_S=600                  # seconds per model turn
export OLLAMA_API_KEY=                            # web search for the agents (optional)
# Check: source ~/.modeler-secrets.env && uv run python -m modeler_agents.llm_check --search
# The admin console's key store: seals the providers' keys stored from the console (Keys). 32 random bytes in base64:
#   python3 -c 'import os,base64;print(base64.b64encode(os.urandom(32)).decode())'
# Changing it makes every stored key unreadable: add them again from the console.
export MODELER_MASTER_KEY=
